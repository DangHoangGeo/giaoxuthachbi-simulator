{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "church-viewer",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "Thach_Bi_Viewer"
      ],
      "port": 8765
    },
    {
      "name": "church-web",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd web && node scripts/start.mjs --port 3100"
      ],
      "port": 3100
    }
  ]
}
