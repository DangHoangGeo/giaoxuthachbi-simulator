  "pages": [
    {
      "id": "project-introduction",
      "slug": "introduction",
      "title": {
        "vi": "Cùng xây dựng nhà thờ Thạch Bi",
        "en": "Building Thạch Bi Church together"
      },
      "body": {
        "vi": "Chúng tôi chia sẻ công việc thiết kế đang phát triển để cộng đoàn và những người có kinh nghiệm có thể cùng xem xét, góp ý và hoàn thiện. Mô hình, hình ý tưởng và phép tính là công cụ nghiên cứu thiết kế; chưa phải hồ sơ được phép dùng để thi công.",
        "en": "We are sharing design work in progress so the community and experienced contributors can review and improve it together. Models, concepts and calculations support design development; they are not construction-approved documents."
      }
    },
    {
      "id": "coordinated-design",
      "slug": "coordinated-design",
      "title": {
        "vi": "Phối hợp các hệ thống",
        "en": "Coordinating the building systems"
      },
      "body": {
        "vi": "Công việc tập trung vào vị trí và cách sử dụng đèn, loa, micro, quạt và hệ thống thông gió, cùng tuyến điện, tủ điện và điều khiển. Phải giữ tầm nhìn về cung thánh, khả năng bảo trì và hiệu quả hoạt động. Phương án quạt lộ rõ trên trục giữa đã bị loại; quạt và loa còn thấy trong hình ý tưởng cũ chưa phải vị trí lắp đặt đã chốt.",
        "en": "The work coordinates lights, loudspeakers, microphones, fans and ventilation with electrical routes, boards and controls. Sanctuary sightlines, maintenance access and performance must be preserved. Exposed centreline fan schemes are excluded; fans and speakers still visible in earlier concepts are not an agreed installation layout."
      }
    },
    {
      "id": "development-limits",
      "slug": "development-limits",
      "title": {
        "vi": "Những điều chưa được xác nhận",
        "en": "What remains unverified"
      },
      "body": {
        "vi": "Một số mục tiêu về ánh sáng, độ rõ lời nói, chống hú và luồng gió còn chưa đạt. Khả năng che giấu thiết bị, dữ liệu sản phẩm, điều kiện lắp đặt và các thông số điện còn phải được kiểm tra. Thông tin dùng để xây dựng cần được người thiết kế có trách nhiệm kiểm tra và chấp thuận.",
        "en": "Some lighting, speech clarity, feedback and airflow targets remain unmet. Equipment concealment, product data, installation conditions and electrical specifications still require checking. Information used to build must be checked and authorized by the responsible designers."
      }
    }
  ],
