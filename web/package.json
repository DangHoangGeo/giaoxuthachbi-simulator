{
  "name": "thach-bi-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.x",
    "npm": "10.9.x"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run check:media && next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "lint": "biome check . --error-on-warnings",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check:boundary": "node scripts/check-build-boundary.mjs",
    "format": "biome check . --write",
    "check:media": "node scripts/check-media.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
