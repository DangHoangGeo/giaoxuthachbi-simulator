# Operating-system metadata (including nested folders)
.DS_Store
._*
Thumbs.db
Desktop.ini

# Local secrets; commit only empty/documented example templates
.env
.env.*
!.env.example
!.env.*.example

# JavaScript dependencies and future web build output
node_modules/
.next/
.vercel/
/web/out/
# Build-time copy of Thach_Bi_Viewer for the 3D visit page (web/scripts/prepare-viewer.mjs)
/web/public/viewer/
# Build-time copy of docs/guides/father-quick-start (web/scripts/prepare-guide.mjs)
/web/public/guide/
/web/dist/
*.tsbuildinfo

# Large direct-sharing deliverables; keep their source manifests and README tracked.
/exports/sharing/*.glb
/exports/sharing/*.zip
/exports/private-review/*.glb.gz

# Local test output and package-manager diagnostics
/web/coverage/
/web/playwright-report/
/web/test-results/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local exports: rendered films and private-review packages. Never publish from here.
/exports/

# Python and editor temporary files
__pycache__/
*.py[cod]
*.swp
*.swo
~$*.xlsx

# Keep source drawings, model assets, Excel registers, review evidence,
# package lockfiles and intentional editor/agent configuration tracked.

# Bulky, regenerable review snapshots (register JSON dumps and rendered previews).
# Curated evidence under review/ (READMEs, verification JSON, logs, screenshots) stays trackable.
review/*/exports/baseline/
review/*/exports/registers/

# Narrated quick-start video; only its small HTML guide, images, narration and clips are tracked.
/docs/guides/father-quick-start/*.mp4
